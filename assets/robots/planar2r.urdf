<?xml version="1.0"?>
<!-- Generated by Ken's RoboLabs v5 from a modified (Craig) DH table.
     Joint origins are the zero-configuration DH transforms; axis is the
     joint-frame z. Re-importing this file reproduces the DH table exactly. -->
<robot name="planar2r">
  <!-- links -->
  <link name="base_link"/>
  <link name="Link 1">
    <inertial>
      <origin xyz="0.175 0 0" rpy="0 0 0"/>
      <mass value="2"/>
      <inertia ixx="0.023616666667" ixy="0" ixz="0" iyy="0.023616666667" iyz="0" izz="0.023616666667"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><cylinder radius="0.02" length="0.05"/></geometry>
      <material name="robolab"><color rgba="0.18 0.55 0.62 1"/></material>
    </visual>
    <collision>
      <geometry><cylinder radius="0.02" length="0.05"/></geometry>
    </collision>
  </link>
  <link name="Link 2">
    <inertial>
      <origin xyz="0.125 0 0" rpy="0 0 0"/>
      <mass value="1.5"/>
      <inertia ixx="0.0102125" ixy="0" ixz="0" iyy="0.0102125" iyz="0" izz="0.0102125"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><cylinder radius="0.077" length="0.35"/></geometry>
      <material name="robolab"><color rgba="0.18 0.55 0.62 1"/></material>
    </visual>
    <collision>
      <geometry><cylinder radius="0.077" length="0.35"/></geometry>
    </collision>
  </link>
  <!-- joints: origin = zero-configuration DH transform, axis = joint z -->
  <joint name="Joint 1" type="revolute">
    <parent link="base_link"/>
    <child link="Link 1"/>
    <origin xyz="0 0 0" rpy="0 0 0.523598775598"/>
    <axis xyz="0 0 1"/>
    <limit lower="-3.14159265359" upper="3.14159265359" effort="150" velocity="3.15"/>
  </joint>
  <joint name="Joint 2" type="revolute">
    <parent link="Link 1"/>
    <child link="Link 2"/>
    <origin xyz="0.35 0 0" rpy="0 0 0.785398163397"/>
    <axis xyz="0 0 1"/>
    <limit lower="-2.617993877991" upper="2.617993877991" effort="150" velocity="3.15"/>
  </joint>
  <!-- fixed tool transform: the DH table leaves a tool-frame offset -->
  <link name="tool_link"/>
  <joint name="tool_tip" type="fixed">
    <parent link="Link 2"/>
    <child link="tool_link"/>
    <origin xyz="0.25 0 0" rpy="0 0 0"/>
  </joint>
</robot>
