<?xml version="1.0"?>
<!-- Generated by Ken's RoboLabs v5 from a modified (Craig) DH table.
     Joint origins are the zero-configuration DH transforms; axis is the
     joint-frame z. Re-importing this file reproduces the DH table exactly. -->
<robot name="scara4">
  <!-- links -->
  <link name="base_link"/>
  <link name="Arm 1">
    <inertial>
      <origin xyz="0.15 0 0" rpy="0 0 0"/>
      <mass value="4"/>
      <inertia ixx="0.0364" ixy="0" ixz="0" iyy="0.0364" iyz="0" izz="0.0364"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><cylinder radius="0.055" length="0.25"/></geometry>
      <material name="robolab"><color rgba="0.18 0.55 0.62 1"/></material>
    </visual>
    <collision>
      <geometry><cylinder radius="0.055" length="0.25"/></geometry>
    </collision>
  </link>
  <link name="Arm 2">
    <inertial>
      <origin xyz="0.125 0 0" rpy="0 0 0"/>
      <mass value="2.5"/>
      <inertia ixx="0.017020833333" ixy="0" ixz="0" iyy="0.017020833333" iyz="0" izz="0.017020833333"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><cylinder radius="0.066" length="0.3"/></geometry>
      <material name="robolab"><color rgba="0.18 0.55 0.62 1"/></material>
    </visual>
    <collision>
      <geometry><cylinder radius="0.066" length="0.3"/></geometry>
    </collision>
  </link>
  <link name="Quill">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="1"/>
      <inertia ixx="0.0016" ixy="0" ixz="0" iyy="0.0016" iyz="0" izz="0.0016"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><cylinder radius="0.055" length="0.25"/></geometry>
      <material name="robolab"><color rgba="0.18 0.55 0.62 1"/></material>
    </visual>
    <collision>
      <geometry><cylinder radius="0.055" length="0.25"/></geometry>
    </collision>
  </link>
  <link name="Wrist">
    <inertial>
      <origin xyz="0 0 0.025" rpy="0 0 0"/>
      <mass value="0.4"/>
      <inertia ixx="0.000723333333" ixy="0" ixz="0" iyy="0.000723333333" iyz="0" izz="0.000723333333"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><cylinder radius="0.02" length="0.05"/></geometry>
      <material name="robolab"><color rgba="0.18 0.55 0.62 1"/></material>
    </visual>
    <collision>
      <geometry><cylinder radius="0.02" length="0.05"/></geometry>
    </collision>
  </link>
  <!-- joints: origin = zero-configuration DH transform, axis = joint z -->
  <joint name="Shoulder" type="revolute">
    <parent link="base_link"/>
    <child link="Arm 1"/>
    <origin xyz="0 0 0.25" rpy="0 0 0.523598775598"/>
    <axis xyz="0 0 1"/>
    <limit lower="-2.268928027593" upper="2.268928027593" effort="150" velocity="3.15"/>
  </joint>
  <joint name="Elbow" type="revolute">
    <parent link="Arm 1"/>
    <child link="Arm 2"/>
    <origin xyz="0.3 0 0" rpy="0 0 1.047197551197"/>
    <axis xyz="0 0 1"/>
    <limit lower="-2.530727415392" upper="2.530727415392" effort="150" velocity="3.15"/>
  </joint>
  <joint name="Z slide" type="prismatic">
    <parent link="Arm 2"/>
    <child link="Quill"/>
    <origin xyz="0.25 0 0" rpy="3.14159265359 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="0" upper="0.15" effort="150" velocity="0.5"/>
  </joint>
  <joint name="Roll" type="revolute">
    <parent link="Quill"/>
    <child link="Wrist"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-3.14159265359" upper="3.14159265359" effort="150" velocity="3.15"/>
  </joint>
  <!-- fixed tool transform: the DH table leaves a tool-frame offset -->
  <link name="tool_link"/>
  <joint name="tool_tip" type="fixed">
    <parent link="Wrist"/>
    <child link="tool_link"/>
    <origin xyz="0 0 0.05" rpy="0 0 0"/>
  </joint>
</robot>
